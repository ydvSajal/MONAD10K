{
    "name":  "@sajalydv/grounded-sdk",
    "version":  "0.1.0",
    "description":  "Payment-grounded reputation for ERC-8004 agents on Monad",
    "license":  "MIT",
    "type":  "module",
    "sideEffects":  false,
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.cjs"
                          },
                    "./server":  {
                                     "types":  "./dist/server.d.ts",
                                     "import":  "./dist/server.js",
                                     "require":  "./dist/server.cjs"
                                 }
                },
    "main":  "./dist/index.cjs",
    "module":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "tsup",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit"
                },
    "dependencies":  {
                         "ox":  "^0.14.45",
                         "viem":  "^2.21.0",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "tsup":  "^8.3.0",
                            "typescript":  "^5.6.0",
                            "vitest":  "^2.1.0",
                            "@types/node":  "^22.7.0"
                        },
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/ydvSajal/MONAD10K.git",
                       "directory":  "packages/sdk"
                   },
    "keywords":  [
                     "erc-8004",
                     "monad",
                     "reputation",
                     "x402",
                     "agents"
                 ]
}
