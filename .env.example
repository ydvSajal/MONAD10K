# Copy to .env and fill. NEVER commit .env. Real secrets live in Vercel/GitHub encrypted env.

# ---------- shared ----------
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz   # public Monad testnet RPC
RPC_URL_FALLBACK=                                   # Alchemy/QuickNode Monad testnet URL (secret); SDK, web, seller and buyer fall back to it when NEXT_PUBLIC_RPC_URL fails
NEXT_PUBLIC_RP_ID=                                  # production domain; MUST equal the contracts' RP_ID

# ---------- contracts ----------
# Deployer key is a Foundry keystore account, never an env var: cast wallet import grounded-deployer --interactive
DEPLOYER_ACCOUNT=grounded-deployer
MONAD_FORK_RPC=                                     # set to run test/fork/* (forge test -n monad)
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3   # verified: EIP-3009, 6dp, EIP-712 name "USDC" v2
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
VERIFIER_API_KEY=                                   # explorer verification key (secret)

# ---------- web ----------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=                                   # secret, server only
PRIVY_WALLET_POLICY_ID=                             # allowlist policy for the drip server wallet (doc 06 §4)
NEXT_PUBLIC_INDEXER_URL=                            # Envio GraphQL endpoint (= ENVIO_GRAPHQL_URL in doc 06)
ALCHEMY_WEBHOOK_SIGNING_KEY=                        # verifies inbound event webhooks (secret)
DRIP_PRIVATE_KEY=                                   # secret, server only. Testnet-only wallet that funds /api/drip; no role in any contract
DRIP_MON_AMOUNT=0.2                                 # per user per 24h
DRIP_USDC_AMOUNT=1                                  # per user per 24h

# ---------- demo seller ----------
SELLER_AGENT_ID=
SELLER_PRICE_USDC=0.05
PORT=8787                                           # demo seller HTTP port
GROUNDED_ADDRESSES=../../deployments/10143.json     # deploy output the demo apps, seed and web read, relative to the app dir; web also takes inline JSON (hosting); unset = "not deployed yet"
LOG_CHUNK_BLOCKS=100                                # web explorer getLogs range per call; 100 fits the Monad public RPC, raise on anvil. Scans are incremental and 8 in parallel
DATABASE_URL=                                       # Postgres (Neon), secret. Demo seller stores used receipts here; unset = in-memory, replayable after a restart

# ---------- demo buyer (local only) ----------
BUYER_PRIVATE_KEY=                                  # secret, testnet only, never committed
BUYER_PASSKEY_SEED=                                 # software authenticator key, testnet only

# ---------- model provider (exactly one; doc 06 §8) ----------
AI_BASE_URL=                                        # OpenAI-compatible endpoint (OpenRouter: https://openrouter.ai/api/v1, KIMI, Qwen, ...)
AI_MODEL=                                           # model id: config, not code (OpenRouter free router: openrouter/free, or pin one ending :free)
AI_API_KEY=                                         # secret

# ---------- Chainlink CRE (only if doc 06 §9 resolves to keep) ----------
CRE_WORKFLOW_ID=

# ---------- explainer video narration (video/narrate.mjs, local only) ----------
ELEVENLABS_API_KEY=                                 # secret; node video/narrate.mjs writes video/audio/*.mp3
ELEVENLABS_VOICE_ID=                                # optional, default stock voice "George"
